{
  "name": "@affanhamid/markdown-renderer",
  "version": "2.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/affanhamid/markdown-renderer"
  },
  "description": "Custom markdown renderer with KaTeX support",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react --external mermaid",
    "test": "jest"
  },
  "dependencies": {
    "katex": "^0.16.28",
    "shiki": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "mermaid": ">=10"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "jest": "^30.2.0",
    "mermaid": "^11.12.3",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT"
}
